{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SecureDeploySSMParameterAccess",
      "Effect": "Allow",
      "Action": [
        "ssm:PutParameter",
        "ssm:GetParameter",
        "ssm:GetParametersByPath",
        "ssm:DeleteParameter",
        "ssm:DescribeParameters"
      ],
      "Resource": "arn:aws:ssm:<region>:<account-id>:parameter/secure-deploy/*"
    },
    {
      "Sid": "SecureDeployKMSDecryptDefaultSSMKey",
      "Effect": "Allow",
      "Action": [
        "kms:Decrypt"
      ],
      "Resource": "arn:aws:kms:<region>:<account-id>:alias/aws/ssm"
    }
  ]
}
