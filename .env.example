# secure-deploy Environment Configuration
# Target deployer environment: local or ec2
DEPLOY_TARGET=local

# AWS EC2 Configuration (Only needed when DEPLOY_TARGET=ec2)
EC2_HOST=ec2-198-51-100-1.compute-1.amazonaws.com
EC2_USER=ubuntu
EC2_KEY_PATH=/path/to/secure-deploy-key.pem

# Allowed workspace root directory
WORKSPACE_ROOT=/app/workspace

# Secrets Management (Day 5)
SECRETS_BACKEND=local
SECRETS_MASTER_KEY=
AWS_REGION=ap-south-1

# Post-Deployment Exposure Probe (Day 5)
AUTO_STOP_ON_EXPOSURE=true
PROBE_VERIFY_TLS=false

# Git Clone Configuration (Timeout in seconds, range 30-600, default 120)
GIT_CLONE_TIMEOUT_SECONDS=120
